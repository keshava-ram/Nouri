# Copy this file to .env and replace the placeholders with your Neon connection strings.
# DATABASE_URL should be the pooled connection string for the app.
# DIRECT_URL should be the direct connection string for Prisma schema updates.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
